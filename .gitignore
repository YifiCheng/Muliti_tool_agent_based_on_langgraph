# 忽略所有文件
*

# 但不忽略 agent-platform 目录
!agent-platform/
!agent-platform/**/

# 只跟踪 agent-platform 及其子目录下的 .py 文件及.yaml文件
!agent-platform/*.py
!agent-platform/**/*.py
!agent-platform/**/*.yaml

# 跟踪 requirements.txt 文件
!agent-platform/requirements.txt

# 跟踪.gitignore 文件
!.gitignore

# 跟踪 .env.example 文件
!agent-platform/.env.example

!docker-compose.yml
!docs/
!docs/**/*.md
!agent-platform/Dockerfile
!agent-platform/.dockerignore

# 跟踪公开文档来源清单和署名文件
!agent-platform/data/source_manifest.yaml
!agent-platform/data/public_docs/
!agent-platform/data/public_docs/NOTICE.md

# 公开文档 raw/clean 由脚本生成，默认不提交
agent-platform/data/public_docs/raw/
agent-platform/data/public_docs/clean/

# 忽略 Python 缓存和编译文件
__pycache__/
*.py[cod]
*$py.class
*.so

.pytest_cache/
*.pyc
*.db
*.sqlite
data/traces/
data/sql/*.db

# 忽略虚拟环境
venv/
env/
.venv/
.env

# 忽略 IDE 配置
.vscode/
.idea/
*.swp
*.swo

# 忽略日志和临时文件
*.log
*.tmp
*.temp

# 忽略操作系统文件
.DS_Store
Thumbs.db
